# Backend HTTP + socket.io port.
PORT=4000

# Where the `links`/`transfer_requests`/`card_requests` tables live. Points
# at a local SQLite file by default (zero setup — see server/src/db.js for
# why). Swap this for a real Postgres connection string
# (e.g. postgres://user:pass@host:5432/db) if this ever moves off SQLite;
# db.js is the only file that would need to change.
DATABASE_URL=./data/links.db

# Origin(s) allowed to call this API / connect via socket.io, comma-separated.
# Must match the frontend's actual dev server URL (Vite defaults to 5173).
CORS_ORIGIN=http://localhost:5173
