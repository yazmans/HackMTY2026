# Backend HTTP + socket.io port.
PORT=4000

# Where the `links` table lives. Points at a local SQLite file by default
# (zero setup — see server/src/db.js for why). Swap this for a real Postgres
# connection string (e.g. postgres://user:pass@host:5432/db) if/when this
# moves off SQLite; db.js is the only file that would need to change.
DATABASE_URL=./data/links.db

# Origin(s) allowed to call this API / connect via socket.io, comma-separated.
CORS_ORIGIN=http://localhost:5199

# Same key as the frontend's VITE_NESSIE_API_KEY — needed here too so
# approved high-value transfers can be executed server-side.
NESSIE_API_KEY=your_key_here
